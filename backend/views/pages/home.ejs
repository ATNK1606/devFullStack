


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test EJS</title>
    <link rel="stylesheet" href="/css/mains.css">
</head>
<body>
    <p>Ceci est ma prmière page en EJS !</p>
    <h1>Bonjour
    <% if(nickname && sex){ %>
        <%= sex === 'M' ? 'Mr ' : 'Mme ' %><%= nickname %>
    <% } else{ %>
        <% if(nickname){ %>
            <%= nickname %>  
        <% } else if (sex){ %>
            <%= sex === 'M' ? 'bel inconnu' : 'belle inconnue' %>
        <% } else { %>
            bel(le) inconnu(e)
        <% }%>
        <% }%>
    </h1>
</body>
</html>

